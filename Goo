-- 4. มองเห็นคนและชื่อ (ESP)
CreateToggle("4. มองเห็นคนและชื่อ (ESP)", function(state)
    Config.ESP = state
    if not state then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("DoofusESP") then
                p.Character.DoofusESP:Destroy()
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if Config.ESP then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
                if not player.Character:FindFirstChild("DoofusESP") then
                    local bgui = Instance.new("BillboardGui")
                    bgui.Name = "DoofusESP"
                    bgui.Parent = player.Character
                    bgui.Adornee = player.Character.Head
                    bgui.AlwaysOnTop = true
                    bgui.Size = UDim2.new(0, 100, 0, 30)
                    bgui.StudsOffset = Vector3.new(0, 3, 0)

                    local lbl = Instance.new("TextLabel")
                    lbl.Parent = bgui
                    lbl.Size = UDim2.new(1, 0, 1, 0)
                    lbl.BackgroundTransparency = 1
                    lbl.Text = player.Name
                    lbl.TextColor3 = Color3.fromRGB(50, 255, 100)
                    lbl.TextStrokeTransparency = 0
                    lbl.TextSize = 12
                    lbl.Font = Enum.Font.SourceSansBold
                end
            end
        end
    end
end)

