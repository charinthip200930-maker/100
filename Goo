-- ฟังก์ชันสร้างปุ่มเปิด/ปิด (Toggle)
local function CreateToggle(text, callback)
    local Button = Instance.new("TextButton")
    Button.Parent = Container
    Button.Size = UDim2.new(1, 0, 0, 28)
    Button.BackgroundColor3 = Color3.fromRGB(15, 45, 22)
    Button.BackgroundTransparency = 0.1
    Button.BorderColor3 = Color3.fromRGB(30, 95, 40)
    Button.Font = Enum.Font.SourceSansBold
    Button.Text = text .. " : [ปิด]"
    Button.TextColor3 = Color3.fromRGB(220, 220, 220)
    Button.TextSize = 13
    Button.ZIndex = 4

    local state = false
    Button.MouseButton1Click:Connect(function()
        state = not state
        if state then
            Button.Text = text .. " : [เปิด]"
            Button.BackgroundColor3 = Color3.fromRGB(25, 85, 38)
            Button.TextColor3 = Color3.fromRGB(100, 255, 150)
        else
            Button.Text = text .. " : [ปิด]"
            Button.BackgroundColor3 = Color3.fromRGB(15, 45, 22)
            Button.TextColor3 = Color3.fromRGB(220, 220, 220)
        end
        callback(state)
    end)
end

-- ฟังก์ชันสร้างช่องกรอกตัวเลข
local function CreateInput(text, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Parent = Container
    Frame.Size = UDim2.new(1, 0, 0, 28)
    Frame.BackgroundColor3 = Color3.fromRGB(15, 45, 22)
    Frame.BackgroundTransparency = 0.1
    Frame.BorderColor3 = Color3.fromRGB(30, 95, 40)
    Frame.ZIndex = 4

    local Label = Instance.new("TextLabel")
    Label.Parent = Frame
    Label.Size = UDim2.new(0.65, 0, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.SourceSansBold
    Label.Text = " " .. text
    Label.TextColor3 = Color3.fromRGB(220, 220, 220)
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 4

    local Box = Instance.new("TextBox")
    Box.Parent = Frame
    Box.Position = UDim2.new(0.65, 0, 0.15, 0)
    Box.Size = UDim2.new(0.3, 0, 0.7, 0)
    Box.BackgroundColor3 = Color3.fromRGB(5, 25, 10)
    Box.BorderColor3 = Color3.fromRGB(40, 120, 55)
    Box.Font = Enum.Font.SourceSans
    Box.Text = tostring(defaultVal)
    Box.TextColor3 = Color3.fromRGB(255, 255, 255)
    Box.TextSize = 12
    Box.ZIndex = 4

    Box.FocusLost:Connect(function()
        local num = tonumber(Box.Text)
        if num then
            callback(num)
        else
            Box.Text = tostring(defaultVal)
        end
    end)
end

